# Copy to .env (`cp .env.example .env`) and uncomment what you want to change.
# docker compose reads .env automatically. .env is git-ignored: keep secrets there, never here.

# Chat model: "ollama" (local, free) or "claude" (paid API). Embeddings always use Ollama.
# LLM_PROVIDER=ollama
# CHAT_MODEL=qwen2.5:7b

# Only needed when LLM_PROVIDER=claude.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
